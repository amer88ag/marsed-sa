{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marsed-sa.example/schemas/provider-registry.schema.json",
  "title": "Marsed Saudi provider registry",
  "type": "object",
  "required": ["schema_version", "registry_type", "providers"],
  "properties": {
    "schema_version": {"type": "string"},
    "registry_type": {"const": "providers"},
    "updated_at": {"type": "string", "format": "date"},
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "official_url", "domain", "auth_mode", "license_status", "health_status"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "name": {"type": "string", "minLength": 1},
          "official_url": {"type": "string", "format": "uri"},
          "domain": {"type": "string"},
          "auth_mode": {"type": "string"},
          "license_status": {"enum": ["approved", "approved_with_conditions", "research_reviewed", "review_required", "approval_required", "rejected"]},
          "health_status": {"enum": ["healthy", "degraded", "not_monitored", "ci_smoke_tested", "not_connected", "unavailable"]},
          "products": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}